--- !u!114 &33527026
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 33527024}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'A thud on your front door pulls you out of the trance.

    If the mailman
    is already out on his route that means... Shit.

    How can you possibly be
    late for your first day back at work?

    You let out an exaugurated sigh with
    the knowledge that you will not hear the end of it from your coworkers.

    Stepping
    out the door, sitting perfectly placed on the welcome mat, is todays newspaper.

    Still
    rigid from tossing around all night, you stretch down to pick it up.

    Seeing
    the headline, a chill runs across your face and hands, your heart feels as if
    it had just stopped.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 938c08f24bff75d479690300d63b53c5, type: 2}
  m_sharedMaterial: {fileID: -7262890071053586275, guid: 938c08f24bff75d479690300d63b53c5, type: 2}
